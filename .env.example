# Copy this file to .env and fill in your values

# Supabase — get these from your project's API settings
# https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Anthropic API key — set this as a Supabase Edge Function secret (NOT in .env):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# See: https://supabase.com/docs/guides/functions/secrets
